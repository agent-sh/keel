{
  "checks": {
    "typecheck": "bunx tsc --noEmit -p .",
    "unit": { "run": "bun test", "args": true },
    "e2e": { "run": "bunx playwright test", "args": true, "cache": false },
    "smoke": { "run": "scripts/smoke.sh", "args": true },
    "remote-verify": { "run": "scripts/remote-verify.sh", "args": true, "tree": { "commit": "last" }, "drop": ["--wait", "--out"] }
  },
  "wait": ["waitfor --capacity"],
  "env": ["KEEL_VERIFY_MAX_RUNS"]
}
