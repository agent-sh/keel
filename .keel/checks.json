{
  "checks": {
    "typecheck": {
      "run": "bunx tsc --noEmit -p .",
      "inputs": [
        "node_modules",
        "node_modules/../bun.lock",
        "node_modules/.bin"
      ],
      "beside": true
    },
    "unit": {
      "run": "bun test",
      "args": true,
      "inputs": [
        "node_modules",
        "node_modules/../bun.lock",
        "node_modules/.bin"
      ],
      "tests": [
        "src/**/*.test.ts",
        "scripts/**/*.test.ts",
        "ui/src/**/*.test.ts"
      ],
      "beside": true
    },
    "e2e": {
      "run": "bunx playwright test",
      "args": true,
      "cache": false
    },
    "smoke": {
      "run": "scripts/smoke.sh",
      "args": true,
      "inputs": [
        "node_modules",
        "node_modules/../bun.lock",
        "node_modules/.bin"
      ]
    },
    "remote-verify": {
      "run": "scripts/remote-verify.sh",
      "args": true,
      "tree": {
        "commit": "last"
      },
      "drop": [
        "--wait",
        "--out"
      ]
    },
    "touched": {
      "run": "bun scripts/touched-tests.ts",
      "inputs": [
        "node_modules",
        "node_modules/../bun.lock",
        "node_modules/.bin"
      ]
    },
    "remote-scripts": {
      "run": "scripts/remote-verify.sh --only scripts"
    }
  },
  "wait": [
    "waitfor --capacity"
  ],
  "env": [
    "KEEL_VERIFY_MAX_RUNS"
  ],
  "pairs": {
    "checks": [
      "typecheck",
      "unit"
    ]
  },
  "land": {
    "setup": "ln -s \"$KEEL_LAND_REPO/node_modules\" node_modules",
    "checks": [
      "typecheck",
      "unit --timeout 60000 ./src/conventions.test.ts ./src/ui-conventions.test.ts",
      "touched",
      "remote-scripts"
    ],
    "push": "origin",
    "after": "bash .keel/land-install.sh"
  }
}
